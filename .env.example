# PeoplePay Model Gateway -- provider configuration. No real keys belong in this file.
# Everything is optional: PeoplePay runs with no AI provider configured (connect one in AI & Models).
# Any variable set here becomes a read-only SYSTEM connection; users can still add their own (BYOK).

# --- Deployment ---------------------------------------------------------------------------------
# self_hosted (default): backend may reach private/loopback addresses (e.g. local Ollama).
# cloud: private, loopback, link-local and metadata addresses are blocked for every custom URL.
PEOPLEPAY_DEPLOYMENT=self_hosted
# cloud mode only: hosts an administrator explicitly approves (comma separated)
PEOPLEPAY_MODELS_HOST_ALLOWLIST=

# --- Storage / credential vault -----------------------------------------------------------------
PEOPLEPAY_MODELS_DB=peoplepay-models.sqlite3
# Required to PERSIST user-entered (BYOK) keys, encrypted with AES-256-GCM.
# Generate one:  python -m peoplepay_models.vault      (never commit it)
# Without it, user-entered keys are held in memory only and lost on restart.
PEOPLEPAY_MODELS_VAULT_KEY=
# PEOPLEPAY_MODELS_VAULT_KEY_FILE=/run/secrets/peoplepay_models_vault_key

# --- Direct providers ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# --- Aggregator ---------------------------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Enterprise platform: Amazon Bedrock (uses the default AWS credential chain / IAM role) -------
# BEDROCK_REGION=us-east-1
# PEOPLEPAY_ENABLE_BEDROCK=1

# --- Inference platform: NVIDIA NIM (hosted or self-hosted) -------------------------------------
NVIDIA_API_KEY=
# NIM_BASE_URL=http://nim.internal:8000/v1

# --- Local ----------------------------------------------------------------------------------------
# Must be reachable from the PeoplePay BACKEND. Self-hosted default probe: http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434
# PEOPLEPAY_MODELS_PROBE_LOCAL_OLLAMA=0   # set 0 to stop registering the default local address

# --- Fast typed-decision providers (not chat models) -----------------------------------------------
# JEV_BASE_URL=
# JEV_API_KEY=
# LAYA_BASE_URL=
# LAYA_API_KEY=

# --- Platform-owner controls -------------------------------------------------------------------------
# PEOPLEPAY_MODELS_DISABLED_PROVIDERS=bedrock,openai_compatible
# PEOPLEPAY_MODELS_ENABLE_MOCK=1          # deterministic demo/test providers; never for production
