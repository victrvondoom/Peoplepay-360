# InflationForge persistence
INFLATIONFORGE_DB=artifacts/inflationforge.db
PRICE_REQUEST_TIMEOUT_S=35
PRICE_SYNC_MIN_INTERVAL_S=300

# Map tiles are runtime-configurable so a production launch can use a provider
# whose traffic plan covers the expected audience. The default is for local/demo use;
# see docs/SCALE.md before a public launch.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_MAX_ZOOM=19

# Bright Data SERP discovery. Live page and Wayback collection remain available
# with an explicitly labeled fallback when Bright Data is unavailable.
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_ZONE=serp_api1

# Port catalog. Empty/invalid credentials produce a clearly labeled local event log.
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_TOKEN=
PORT_API_URL=https://api.port.io/v1

# SigNoz / OTLP. A local JSONL audit is active in every mode.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=inflationforge
INFLATIONFORGE_OTEL_EXPORTER=console

# Render deployment (keep the real key only in .env / Render secret settings)
RENDER_API_KEY=

# Self-hosted SigNoz service-account query access (not OTLP ingestion).
SIGNOZ_API_URL=http://localhost:8080
SIGNOZ_UI_URL=http://localhost:8080
SIGNOZ_API_KEY=
SIGNOZ_TOKENIZER_JWT_SECRET=
SIGNOZ_ROOT_EMAIL=inflationforge@local.dev
SIGNOZ_ROOT_PASSWORD=
SIGNOZ_ROOT_ORG_NAME=InflationForge
